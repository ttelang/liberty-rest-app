<?xml version="1.0" encoding="UTF-8"?>
<server description="Shopping Cart Service">
    <featureManager>
        <feature>jakartaee-10.0</feature>
        <feature>microProfile-6.1</feature>
    </featureManager>

    <httpEndpoint id="defaultHttpEndpoint" httpPort="4050" httpsPort="4443" />

    <webApplication location="shoppingcart.war" contextRoot="/shoppingcart" />

    <!-- Define a basic user registry with a single user -->
    <basicRegistry id="basic" realm="BasicRealm">
        <user name="admin" password="adminpwd" />
    </basicRegistry>

    <!-- Log to stdout in JSON format -->
    <logging traceSpecification="com.ibm.ws.microprofile.*=all" 
             consoleLogLevel="INFO" 
             consoleFormat="json" 
             consoleSource="message,trace,accessLog,ffdc" />

    <!-- Define unique instance ID -->
    <variable name="server.name" value="ShoppingCartService" />
    
    <!-- Application information -->
    <applicationManager autoExpand="true" />
    
    <!-- Health check endpoint configurations -->
    <mpHealth />
</server>
