<server description="MicroProfile Tutorial Liberty Server">
    <featureManager>
        <platform>jakartaEE-10.0</platform>
        <platform>microProfile-6.1</platform>
        <feature>restfulWS</feature>
        <feature>jsonp</feature>
        <feature>jsonb</feature>
        <feature>cdi</feature>
        <feature>mpConfig</feature>
        <feature>mpOpenAPI</feature>
        <feature>mpHealth</feature>
        <feature>mpFaultTolerance</feature>
        <feature>mpTelemetry</feature>
    </featureManager>

    <httpEndpoint httpPort="${default.http.port}" httpsPort="${default.https.port}"
                  id="defaultHttpEndpoint" host="*" />
    <webApplication location="payment.war" contextRoot="${app.context.root}"/>
    <logging traceSpecification="*=info:com.ibm.ws.webcontainer*=all:com.ibm.ws.jaxrs*=all:com.ibm.ws.app.manager*=all:com.ibm.ws.microprofile.health.*=all:io.microprofile.tutorial.store.product.*=all:io.microprofile.tutorial.store.payment.*=all" />
    
    <!-- MicroProfile Telemetry Configuration -->
    <mpTelemetry serviceName="payment-service">
        <otlpExporter endpoint="http://localhost:4318" />
        <resource>
            <attribute name="service.name" value="payment-service" />
            <attribute name="service.version" value="1.0.0" />
            <attribute name="deployment.environment" value="development" />
        </resource>
    </mpTelemetry>
</server>